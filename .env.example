# Local development settings. Replace the development-only webhook secret outside local use.
DATABASE_URL=postgresql+asyncpg://seatlock:seatlock@localhost:5432/seatlock
REDIS_URL=redis://localhost:6379/0
ENVIRONMENT=development
# Optional: uncomment and replace to protect /admin/* with a bearer token.
# ADMIN_TOKEN=replace-with-a-long-random-token
HOLD_TTL_SECONDS=300
PAYMENT_WEBHOOK_SECRET=replace-with-a-local-random-secret
HOLD_RATE_CAPACITY=20
HOLD_RATE_PER_SECOND=10.0
QUEUE_JOIN_RATE_CAPACITY=5
QUEUE_JOIN_RATE_PER_SECOND=2.0
ADMISSION_TTL_SECONDS=600
